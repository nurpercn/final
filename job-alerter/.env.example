# Recipient (your email)
ALERT_TO_EMAIL=nur.percin@hotmail.com

# SMTP — Outlook/Hotmail example
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_USER=nur.percin@hotmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM=nur.percin@hotmail.com
SMTP_USE_TLS=true

# Optional: Reed.co.uk API (free) — https://www.reed.co.uk/developers
REED_API_KEY=

# Optional: Adzuna API (free) — https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Search defaults
SEARCH_LOCATION=United Kingdom
SEARCH_COUNTRY=gb
MIN_MATCH_SCORE=45
MAX_JOBS_PER_EMAIL=40
LOOKBACK_DAYS=3
